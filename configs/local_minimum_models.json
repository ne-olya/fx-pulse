{
  "schema_version": 1,
  "description": "Nested walk-forward benchmark for CNY/RUB recommendations. The future minimum is a hindsight label: each model predicts whether the current close remains no worse than every close in the following horizon.",
  "evaluation": {
    "target_instrument_id": "fx_cny_rub_tom",
    "horizons": [1, 5, 20],
    "candidate_policy": "all_observable_days",
    "tolerance_bps": 0.0,
    "min_training_observations": 252,
    "inner_selection_observations": 126,
    "minimum_candidate_training_observations": 20,
    "factor_lag_observations": 1,
    "target_return_windows": [1, 3, 5, 20],
    "factor_return_windows": [1, 3, 5],
    "volatility_windows": [5, 20],
    "distance_to_min_windows": [5, 20, 60],
    "past_min_windows": [1, 5, 20],
    "models": [
      "ridge_logistic",
      "gradient_boosted_stumps",
      "xgboost",
      "random_forest",
      "extra_trees",
      "adaboost",
      "gradient_boosting",
      "svc_rbf"
    ],
    "ridge_l2": 1.0,
    "max_iterations": 100,
    "boosted_stumps": {
      "iterations": 12,
      "learning_rate": 0.1,
      "min_leaf": 10,
      "quantiles": [0.2, 0.4, 0.6, 0.8]
    },
    "xgboost": {
      "n_estimators": 80,
      "max_depth": 2,
      "learning_rate": 0.05,
      "min_child_weight": 10,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 5.0
    },
    "sklearn": {
      "random_forest": {"n_estimators": 40, "max_depth": 3, "min_samples_leaf": 10, "max_features": 0.7},
      "extra_trees": {"n_estimators": 40, "max_depth": 3, "min_samples_leaf": 10, "max_features": 0.7},
      "adaboost": {"n_estimators": 30, "learning_rate": 0.05, "min_samples_leaf": 10},
      "gradient_boosting": {"n_estimators": 40, "learning_rate": 0.05, "max_depth": 2, "min_samples_leaf": 10, "subsample": 0.8},
      "svc_rbf": {"C": 0.5, "gamma": "scale"}
    },
    "score_quantiles": [0.5, 0.65, 0.8],
    "minimum_selection_signals": 3,
    "minimum_signals_per_week": 0.5,
    "maximum_signals_per_week": 2.0,
    "selection_minimum_lift": 1.0,
    "promotion_minimum_lift": 1.3,
    "minimum_selection_benefit_bps": 0.0,
    "no_signal_fallback": "do_not_send"
  }
}
